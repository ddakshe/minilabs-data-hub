KOSIS_API_KEY=your_kosis_api_key_here
# 한국천문연구원 특일정보 API (data.go.kr) — Decoding 키
KASI_SERVICE_KEY=your_kasi_service_key_here
# KAMIS OpenAPI (한국농수산식품유통공사) — p_cert_key(UUID) + p_cert_id(가입 id)
KAMIS_CERT_KEY=your_kamis_cert_key_here
KAMIS_CERT_ID=your_kamis_cert_id_here
# KOBIS OpenAPI (영화진흥위원회) — now-showing 스파인/박스오피스/상세
KOBIS_KEY=your_kobis_key_here
# KMDb (한국영상자료원) — 포스터/줄거리 보강. 미설정 시 KOBIS-only 로 동작
KMDB_KEY=your_kmdb_key_here
# 소비자24 리콜정보 OpenAPI — 카테고리마다 키가 달라 JSON 맵 하나로 넣는다
# {"0101":"공산품키","0201":"식품키", ...}  cntntsId 는 scripts/fetch-recall.mjs 참조
RECALL_API_KEYS={"0101":"...","0201":"..."}
